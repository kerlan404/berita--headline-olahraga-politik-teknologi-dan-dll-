# ═══════════════════════════════════════════
# REEDSFEED — Environment Configuration
# ═══════════════════════════════════════════

# ── CORS Proxy (untuk Flutter Web / Chrome) ──
# NewsAPI tidak mendukung CORS dari browser.
# Proxy ini meneruskan request dengan CORS headers.
# Cara pakai: jalankan `node server/proxy.js` lalu set URL di bawah.
# Kosongkan untuk menggunakan Mock Data di web.
CORS_PROXY_URL=http://localhost:4000

# ── AI Editor API (OpenAI-compatible) ──
# Dapatkan API key dari: https://platform.openai.com/api-keys
# Atau gunakan provider OpenAI-compatible lain:
#   - Groq (gratis): https://console.groq.com/keys
#   - DeepSeek: https://platform.deepseek.com/api_keys
#   - Together AI: https://api.together.ai/settings/api-keys
# Tanpa API key, sistem akan menggunakan Local Engine bawaan.
OPENAI_API_KEY=

# Base URL untuk OpenAI-compatible API
# Default: https://api.openai.com/v1
# Contoh alternatif:
#   Groq:    https://api.groq.com/openai/v1
#   DeepSeek: https://api.deepseek.com
#   Together: https://api.together.xyz/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Model AI yang digunakan (default: gpt-4o-mini)
# Untuk analisis artikel, rekomendasi:
#   - gpt-4o-mini (cepat & murah, ~$0.15/1M token)
#   - gpt-4o (lebih akurat, ~$2.50/1M token)
#   - deepseek-chat (gratis via DeepSeek API)
#   - llama-3.3-70b (gratis via Groq)
OPENAI_MODEL=gpt-4o-mini
